# MERCADO VIVO — variáveis de ambiente (exemplo)
# Copiar para .env.local e preencher com os valores reais do projeto Supabase.
# NUNCA commitar segredos (service_role key, tokens, etc.).

# URL do projeto Supabase (Settings -> API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Chave pública (anon) — segura no cliente porque a segurança real é garantida por RLS
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Nome/slug do projeto (opcional, usado pelo Playwright e scripts)
VITE_PROJECT_NAME=mercado-vivo

# ---- SEGREDOS QUE NUNCA VANNO NO FRONTEND (usar apenas em supabase/config ou dashboard) ----
# SUPABASE_SERVICE_ROLE_KEY=  -> só para Edge Functions/admin CLI, nunca prefixar com VITE_
